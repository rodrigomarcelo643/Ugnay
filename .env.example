# UGNAY Application Environment Configuration (Template)
# Copy this file to .env and fill in your actual credentials.

# Public API Configuration
EXPO_PUBLIC_API_URL=https://api.ugnay.app
EXPO_PUBLIC_ENV=development

# Supabase Credentials
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Agora RTC Credentials
EXPO_PUBLIC_AGORA_APP_ID=your_agora_app_id_here
EXPO_PUBLIC_AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# OPEN AI
EXPO_PUBLIC_OPENAI_KEY=your_openai_api_key_here

# GOOGLE MAP
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OPENROUTESERVICE
EXPO_PUBLIC_OPENROUTESERVICE_KEY=your_openrouteservice_key_here
