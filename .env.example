# UGNAY Application Environment Configuration Template

# Public API Configuration
EXPO_PUBLIC_API_URL=https://api.ugnay.app
EXPO_PUBLIC_ENV=development

# Supabase Credentials (Mobile Client)
EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Agora RTC Credentials (Mobile Client)
EXPO_PUBLIC_AGORA_APP_ID=your-agora-app-id-here

# OpenRouteService API (100% Free / Open-Source Routing & Isochrones)
# Sign up free at https://openrouteservice.org/dev/#/signup
EXPO_PUBLIC_OPENROUTESERVICE_KEY=your_openrouteservice_api_key_here

# NOTE: Server-side Secrets (DO NOT INCLUDE IN MOBILE CLIENT .env!)
# Set these inside your Supabase Edge Function Secrets:
# AGORA_APP_CERTIFICATE=your_agora_app_certificate
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# AI_API_KEY=your_ai_api_key
